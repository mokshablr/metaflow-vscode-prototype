{
  "name": "metaflow-vscode-prototype",
  "displayName": "Metaflow",
  "description": "Metaflow VS Code extension",
  "version": "0.2.0",
  "publisher": "local",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Other"],
  "repository": {
    "type": "git",
    "url": "https://github.com/mokshablr/metaflow-vscode-prototype"
  },
  "activationEvents": [
    "onCommand:metaflow.runFlow",
    "onCommand:metaflow.spinStep",
    "onView:metaflowExplorer",
    "onCommand:metaflow.showDAG"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "metaflowExplorer",
          "name": "Metaflow"
        }
      ]
    },
    "commands": [
      {
        "command": "metaflow.runFlow",
        "title": "Metaflow: Run Flow"
      },
      {
        "command": "metaflow.spinStep",
        "title": "Metaflow: Spin Current Step"
      },
      {
        "command": "metaflow.refreshExplorer",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "metaflow.filterRuns",
        "title": "Filter Runs",
        "icon": "$(filter)"
      },
      {
        "command": "metaflow.cycleSortArtifacts",
        "title": "Sort Artifacts",
        "icon": "$(list-ordered)"
      },
      {
        "command": "metaflow.copyArtifactValue",
        "title": "Copy Value"
      },
      {
        "command": "metaflow.exportArtifactJson",
        "title": "Export as JSON"
      },
      {
        "command": "metaflow.deleteRun",
        "title": "Delete Run",
        "icon": "$(trash)"
      },
      {
        "command": "metaflow.showDAG",
        "title": "Metaflow: Show DAG",
        "icon": "$(type-hierarchy)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "metaflow.refreshExplorer",
          "when": "view == metaflowExplorer",
          "group": "navigation"
        },
        {
          "command": "metaflow.filterRuns",
          "when": "view == metaflowExplorer",
          "group": "navigation"
        },
        {
          "command": "metaflow.cycleSortArtifacts",
          "when": "view == metaflowExplorer",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "metaflow.showDAG",
          "when": "resourceExtname == .py",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "metaflow.showDAG",
          "when": "editorLangId == python",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "metaflow.copyArtifactValue",
          "when": "view == metaflowExplorer && viewItem == artifact",
          "group": "1_artifact@1"
        },
        {
          "command": "metaflow.exportArtifactJson",
          "when": "view == metaflowExplorer && viewItem == artifact",
          "group": "1_artifact@2"
        },
        {
          "command": "metaflow.deleteRun",
          "when": "view == metaflowExplorer && viewItem == run",
          "group": "navigation@99"
        }
      ]
    },
    "configuration": {
      "title": "Metaflow",
      "properties": {
        "metaflow.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Path to the Python interpreter that has Metaflow installed."
        }
      }
    },
    "keybindings": [
      {
        "command": "metaflow.runFlow",
        "key": "ctrl+alt+r",
        "when": "editorLangId == python"
      },
      {
        "command": "metaflow.spinStep",
        "key": "ctrl+alt+s",
        "when": "editorLangId == python"
      },
      {
        "command": "metaflow.showDAG",
        "key": "ctrl+alt+d",
        "when": "editorLangId == python"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.0.0"
  }
}
