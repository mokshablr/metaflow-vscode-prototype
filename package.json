{
  "name": "metaflow-vscode-prototype",
  "displayName": "Metaflow",
  "description": "Metaflow VS Code extension",
  "version": "0.2.0",
  "publisher": "local",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Other"],
  "repository": {
    "type": "git",
    "url": "https://github.com/mokshablr/metaflow-vscode-prototype"
  },
  "activationEvents": [
    "onCommand:metaflow.runFlow",
    "onCommand:metaflow.spinStep",
    "onView:metaflowExplorer"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "metaflowExplorer",
          "name": "Metaflow"
        }
      ]
    },
    "commands": [
      {
        "command": "metaflow.runFlow",
        "title": "Metaflow: Run Flow"
      },
      {
        "command": "metaflow.spinStep",
        "title": "Metaflow: Spin Current Step"
      },
      {
        "command": "metaflow.refreshExplorer",
        "title": "Refresh Metaflow Explorer",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "metaflow.refreshExplorer",
          "when": "view == metaflowExplorer",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Metaflow",
      "properties": {
        "metaflow.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Path to the Python interpreter that has Metaflow installed."
        }
      }
    },
    "keybindings": [
      {
        "command": "metaflow.runFlow",
        "key": "ctrl+alt+r",
        "when": "editorLangId == python"
      },
      {
        "command": "metaflow.spinStep",
        "key": "ctrl+alt+s",
        "when": "editorLangId == python"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.0.0"
  }
}
