{
  "name": "metaflow-vscode-prototype",
  "displayName": "Metaflow",
  "description": "Metaflow VS Code extension",
  "version": "0.2.0",
  "publisher": "local",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mokshablr/metaflow-vscode-prototype"
  },
  "activationEvents": [
    "onCommand:metaflow.runFlow",
    "onCommand:metaflow.spinStep",
    "onView:metaflowExplorer",
    "onCommand:metaflow.showDAG",
    "onCommand:metaflow.monitorRun",
    "onCommand:metaflow.debugStep",
    "onCommand:metaflow.debugStepFromEditor",
    "onCommand:metaflow.showRunDAG",
    "onCommand:metaflow.launchRun"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "metaflowExplorer",
          "name": "Metaflow"
        }
      ]
    },
    "commands": [
      {
        "command": "metaflow.runFlow",
        "title": "Metaflow: Run Flow"
      },
      {
        "command": "metaflow.spinStep",
        "title": "Metaflow: Spin Current Step"
      },
      {
        "command": "metaflow.refreshExplorer",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "metaflow.filterRuns",
        "title": "Filter Runs",
        "icon": "$(filter)"
      },
      {
        "command": "metaflow.cycleSortArtifacts",
        "title": "Sort Artifacts",
        "icon": "$(list-ordered)"
      },
      {
        "command": "metaflow.copyArtifactValue",
        "title": "Copy Value"
      },
      {
        "command": "metaflow.exportArtifactJson",
        "title": "Export as JSON"
      },
      {
        "command": "metaflow.deleteRun",
        "title": "Delete Run",
        "icon": "$(trash)"
      },
      {
        "command": "metaflow.showDAG",
        "title": "Metaflow: Show DAG",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "metaflow.monitorRun",
        "title": "Metaflow: Monitor Run"
      },
      {
        "command": "metaflow.debugStep",
        "title": "Debug Step"
      },
      {
        "command": "metaflow.debugStepFromEditor",
        "title": "Metaflow: Debug Last Run of This Step"
      },
      {
        "command": "metaflow.showRunDAG",
        "title": "Show DAG",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "metaflow.launchRun",
        "title": "Metaflow: Launch Run"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "metaflow.refreshExplorer",
          "when": "view == metaflowExplorer",
          "group": "navigation"
        },
        {
          "command": "metaflow.filterRuns",
          "when": "view == metaflowExplorer",
          "group": "navigation"
        },
        {
          "command": "metaflow.cycleSortArtifacts",
          "when": "view == metaflowExplorer",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "metaflow.showDAG",
          "when": "resourceExtname == .py",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "metaflow.showDAG",
          "when": "editorLangId == python",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "metaflow.copyArtifactValue",
          "when": "view == metaflowExplorer && viewItem == artifact",
          "group": "1_artifact@1"
        },
        {
          "command": "metaflow.exportArtifactJson",
          "when": "view == metaflowExplorer && viewItem == artifact",
          "group": "1_artifact@2"
        },
        {
          "command": "metaflow.deleteRun",
          "when": "view == metaflowExplorer && viewItem == run",
          "group": "navigation@99"
        },
        {
          "command": "metaflow.debugStep",
          "when": "view == metaflowExplorer && viewItem == step",
          "group": "debug@1"
        },
        {
          "command": "metaflow.showRunDAG",
          "when": "view == metaflowExplorer && viewItem == run",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "Metaflow",
      "properties": {
        "metaflow.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Path to the Python interpreter that has Metaflow installed."
        }
      }
    },
    "keybindings": [
      {
        "command": "metaflow.runFlow",
        "key": "ctrl+alt+r",
        "when": "editorLangId == python"
      },
      {
        "command": "metaflow.spinStep",
        "key": "ctrl+alt+s",
        "when": "editorLangId == python"
      },
      {
        "command": "metaflow.showDAG",
        "key": "ctrl+alt+d",
        "when": "editorLangId == python"
      },
      {
        "command": "metaflow.monitorRun",
        "key": "ctrl+alt+m",
        "when": "editorLangId == python"
      },
      {
        "command": "metaflow.debugStepFromEditor",
        "key": "ctrl+alt+shift+d",
        "when": "editorLangId == python"
      },
      {
        "command": "metaflow.launchRun",
        "key": "ctrl+alt+l",
        "when": "editorLangId == python"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "compile:tests": "tsc -p ./tsconfig.test.json",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile:tests",
    "test": "node ./out/test/runTest.js",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/glob": "^9.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "@vscode/test-electron": "^2.5.2",
    "glob": "^13.0.6",
    "mocha": "^11.7.5",
    "typescript": "^5.0.0"
  }
}
